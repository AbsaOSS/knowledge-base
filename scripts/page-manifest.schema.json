{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/AbsaOSS/knowledge-base/master/scripts/page-manifest.schema.json",
  "title": "Knowledge base page manifest (dist/_kb/pages.json)",
  "description": "Every documentation page a build published, with its app. Written by scripts/page-manifest.js, read by the MCP indexer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pathPrefix", "apps", "pages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "pathPrefix": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name", "description", "tags", "kind", "url", "sourceVersion"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "kind": { "enum": ["artifact", "iframe"] },
          "url": { "type": ["string", "null"] },
          "sourceVersion": { "type": ["string", "null"] }
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["app", "route", "file", "title", "section"],
        "properties": {
          "app": { "type": "string" },
          "route": { "type": "string", "pattern": "^/[a-z0-9-]+/.+/$" },
          "file": { "type": "string", "pattern": "^[^/].*/index\\.html$" },
          "title": { "type": ["string", "null"] },
          "section": { "type": ["string", "null"] }
        }
      }
    }
  }
}
