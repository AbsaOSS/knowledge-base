# The Docker image only needs nginx.conf, the two nginx.*headers.conf files and
# the prebuilt dist/ (see Dockerfile). mcp-server/Dockerfile has its own
# Dockerfile.dockerignore.
# Keep the build context small and avoid leaking source/secrets into the image.
node_modules
.git
.github
tests
scripts
src
contract
plugins
public
apps
tmp
.astro
playwright-report
test-results
*.md
.gitignore
.dockerignore
.env
Dockerfile
playwright*.js
astro.config.mjs
vite.config.js
tsconfig.json
package-lock.json
apps.json
mcp-server

# The page manifest is build metadata for the MCP indexer, not site content:
# keep it out of the nginx web root. mcp-server/Dockerfile.dockerignore lets it in.
dist/_kb
