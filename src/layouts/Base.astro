---
// src/layouts/Base.astro
//
// The single document shell for every knowledge base page — landing catalog,
// packaged sub-app pages and iframe entries alike. It owns <head>, the fonts,
// the knowledge base stylesheet, <ClientRouter /> and the shadow-DOM compat styles,
// so none of that has to be string-injected into sub-app documents any more.
//
// The knowledge base is light-only. There is no theme toggle, no persisted theme and
// no `dark` class anywhere, so an embedding host's theme can never bleed in.
//
// THE STYLESHEET IS INLINED INTO <body>, NOT LINKED FROM <head>
//
// Inside a web fragment the <head> belongs to reframed, which patches
// document.head to a wf-head element in the host's shadow tree and has a
// history of losing, relocating or duplicating head <link>/<style> nodes when
// the ClientRouter navigates (web-fragments issue #297). A <link> in that head
// is therefore the one thing the knowledge base cannot afford to depend on:
// drop it during a swap and the catalog and masthead render unstyled. The body,
// on the other hand, is replaced whole on every navigation — reframed and
// Astro agree on that — so a <style> that travels inside it is present exactly
// when its page is, and gone when the page is. The `?inline` import gives the
// compiled Tailwind output as a string, fonts resolved to hashed assets, and
// scripts/build-vite.js publishes the same bytes as dist/style.css for anything
// outside this repository that still fetches the stylesheet by URL.
//
// Sub-app CSS is not given the same treatment; it is wrapped in a cascade
// layer instead, so that if it does leak it cannot restyle the knowledge base
// (src/utils/css-layers.js).
import kbStylesheet from '../styles/knowledge-base.css?inline';
import { ClientRouter } from 'astro:transitions';
import { shadowCompatStyle } from '../templates/shadow-compat.js';
import { isHeadlessBuild } from '../utils/config.js';
import { LAYER_ORDER } from '../utils/css-layers.js';

interface Props {
  title?: string;
  /** Per-app override. Undefined means "whatever this build is" — see config.js. */
  headless?: boolean;
  /** Extra classes for <body> — packaged sub-app pages pass their own body class. */
  bodyClass?: string;
  /** Full-height flex column body. Off for sub-app content, which brings its own layout. */
  flexBody?: boolean;
}

const {
  title = 'Knowledge base',
  headless,
  bodyClass = '',
  flexBody = true,
} = Astro.props;

// `??`, not `||`: an app pinned "headless": false in apps.json must be able to
// opt out of a headless build. With `||` the prop could only ever turn headless
// on, so the override was write-only in one direction (#52).
const effectiveHeadless = headless ?? isHeadlessBuild();

const bodyClasses = [
  flexBody ? 'min-h-screen flex flex-col' : '',
  bodyClass,
].filter(Boolean).join(' ') || undefined;
---

<!DOCTYPE html>
<html lang="en" data-kb-headless={effectiveHeadless ? 'true' : undefined}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Documentation knowledge base — browse all doc sites in one place." />
  <title>{title}</title>
  {/*
    Cascade layer order — must be the first stylesheet the browser parses.

    Layer priority is fixed by the first statement naming the layers, so this
    one line decides that Tailwind's Preflight (`base`) sits below every
    sub-app stylesheet (`kb-app`: a docs theme keeps its heading sizes), and
    that `kb-app` sits below the knowledge base's own rules and utilities (a
    leaked docs theme cannot restyle the masthead or the catalog). The order
    is repeated at the top of every rewritten sub-app stylesheet and of the
    knowledge base stylesheet, so it holds even if this node is lost in a
    fragment's head swap. See src/utils/css-layers.js.
  */}
  <style is:inline set:html={LAYER_ORDER}></style>
  <slot name="head" />
  {/* Embedded as a web fragment, the ClientRouter needs two corrections — a
      view transition on the host document, and a swap that keeps reframed's
      wf-* tree flat. Standalone the module is inert. Bundled to a file, never
      inlined, so `script-src 'self'` holds (see astro.config.mjs). */}
  <script>
    import '../scripts/embedded-transitions.js';
  </script>
  <ClientRouter />
</head>
<body class={bodyClasses} style="background-color:var(--bg-page)">
  {/* The knowledge base stylesheet, Inter's self-hosted @font-face included.
      First in the body so it is parsed before any content it styles — and in
      the body at all for the reason in the header comment. The layer order is
      prepended here rather than written in knowledge-base.css: Tailwind drops
      a bare `@layer a, b;` statement from its output, so the compiled sheet
      alone would establish `theme, base, …, kb-reset` and never name `kb-app`,
      and a runtime that parses this block before the <head> would then order
      the sub-app layer above the fence. */}
  <style is:inline data-kb-stylesheet set:html={LAYER_ORDER + '\n' + kbStylesheet}></style>
  {/* The design tokens the fragment's shadow tree reads, likewise ahead of the
      content: a blocking <script src> in a sub-app body (a vendored mermaid
      bundle is 2.5 MB) holds the parser, and until it reaches this block an
      embedded page renders with no tokens — black text, no theme. */}
  <Fragment set:html={shadowCompatStyle} />
  <slot />
</body>
</html>
