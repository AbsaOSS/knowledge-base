---
// src/layouts/Base.astro
//
// The single document shell for every knowledge base page — landing catalog,
// packaged sub-app pages and iframe entries alike. It owns <head>, the fonts,
// the knowledge base stylesheet, <ClientRouter /> and the shadow-DOM compat styles,
// so none of that has to be string-injected into sub-app documents any more.
//
// The knowledge base is light-only. There is no theme toggle, no persisted theme and
// no `dark` class anywhere, so an embedding host's theme can never bleed in.
import '../styles/knowledge-base.css';
import { ClientRouter } from 'astro:transitions';
import { shadowCompatStyle } from '../templates/shadow-compat.js';
import { isHeadlessBuild } from '../utils/config.js';

interface Props {
  title?: string;
  /** Per-app override. Undefined means "whatever this build is" — see config.js. */
  headless?: boolean;
  /** Extra classes for <body> — packaged sub-app pages pass their own body class. */
  bodyClass?: string;
  /** Full-height flex column body. Off for sub-app content, which brings its own layout. */
  flexBody?: boolean;
}

const {
  title = 'Knowledge base',
  headless,
  bodyClass = '',
  flexBody = true,
} = Astro.props;

// `??`, not `||`: an app pinned "headless": false in apps.json must be able to
// opt out of a headless build. With `||` the prop could only ever turn headless
// on, so the override was write-only in one direction (#52).
const effectiveHeadless = headless ?? isHeadlessBuild();

const bodyClasses = [
  flexBody ? 'min-h-screen flex flex-col' : '',
  bodyClass,
].filter(Boolean).join(' ') || undefined;
---

<!DOCTYPE html>
<html lang="en" data-kb-headless={effectiveHeadless ? 'true' : undefined}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Documentation knowledge base — browse all doc sites in one place." />
  <title>{title}</title>
  {/*
    CSS layer ordering fix — must appear before sub-app stylesheets.

    Problem: Tailwind (style.css) uses @layer base which includes Preflight
    (h1-h6 { font-size: inherit }). Starlight uses @layer starlight.content
    (h1 { font-size: var(--sl-text-h1) }). CSS layer priority is determined
    by FIRST DECLARATION ORDER: the last-declared layer wins.

    On direct URL load the HTML order is:
      <slot name="head">  ← Starlight CSS (starlight.* layers declared first)
      <link style.css>   ← Tailwind (base layer declared last → wins)
    Result: Tailwind Preflight clobbers all Starlight heading sizes → layout broken.

    On router navigation style.css was already loaded on the KB homepage, so
    its @layer base was declared first and Starlight's layers win. This is why
    router nav appears correct but direct load is broken.

    Fix: declare @layer base here, before the slot, so Tailwind's base layer is
    always established first (lowest priority) regardless of stylesheet load order.
    Starlight's layers, declared later via the slot, will always have higher priority.
  */}
  <style is:inline>@layer base;</style>
  <slot name="head" />
  {/* Inter is self-hosted: its @font-face lives in knowledge-base.css, which the
      layout already imports, so there is nothing to link here (#54). */}
  <ClientRouter />
</head>
<body class={bodyClasses} style="background-color:var(--bg-page)">
  <slot />
  <Fragment set:html={shadowCompatStyle} />
</body>
</html>
