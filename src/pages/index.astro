---
// src/pages/index.astro
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import AppCard from '../components/AppCard.astro';

const HEADLESS = process.env.MP_HEADLESS !== 'false';

// Load apps from apps.json at the repo root
const appsPath = resolve('apps.json');
const apps = JSON.parse(readFileSync(appsPath, 'utf-8'));

const buildDate = new Date().toISOString().slice(0, 10);
---

<Base headless={HEADLESS}>
  {!HEADLESS && <Chrome apps={apps} activeSlug="" base="/knowledge-base" />}

  <div class="flex flex-col flex-1">
    <!-- Page header -->
    <div style="background:var(--bg-card);border-bottom:1px solid var(--border)">
      <div class="max-w-6xl mx-auto px-6 md:px-10 pt-12 pb-0">
        <div class="flex items-center gap-2 mb-3 animate-fade-up">
          <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0"
               style="background:var(--color-absa-50);color:var(--color-absa-500)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
            </svg>
          </div>
          <span class="text-xs font-bold uppercase tracking-widest" style="color:var(--color-absa-500)">ABSA</span>
        </div>
        <h1 class="text-4xl font-bold tracking-tight mb-2 animate-fade-up delay-1" style="color:var(--text-heading)">
          Knowledge base
        </h1>
        <p class="text-base max-w-xl leading-relaxed mb-8 animate-fade-up delay-2" style="color:var(--text-muted)">
          Browse and access all internal ABSA documentation sites. Each app is independently
          maintained and deployed — one consistent experience.
        </p>
      </div>
    </div>

    <!-- App catalog -->
    <main id="content" class="flex-1 max-w-6xl mx-auto w-full px-6 md:px-10 py-10" aria-label="Documentation catalog">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xs font-bold uppercase tracking-widest" style="color:var(--text-muted)">
          {apps.length} Apps
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" role="list">
        {apps.map((app: any, i: number) => (
          <AppCard app={app} delay={i < 4 ? i + 1 : 0} base="/knowledge-base" />
        ))}
      </div>
    </main>

    <!-- Footer -->
    <footer class="border-t px-6 md:px-10 py-6" style="border-color:var(--border)">
      <div class="max-w-6xl mx-auto flex items-center justify-between text-xs" style="color:var(--text-muted)">
        <span>© {new Date().getFullYear()} ABSA Group</span>
        <span>Built {buildDate}</span>
      </div>
    </footer>
  </div>
</Base>
