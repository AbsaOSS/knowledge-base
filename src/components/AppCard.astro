---
// src/components/AppCard.astro
import AppIcon from './AppIcon.astro';

interface Props {
  app: {
    slug: string;
    name: string;
    description: string;
    icon?: string;
    tags?: string[];
  };
  delay?: number;
  base?: string;
}

const { app, delay = 0, base = '/knowledge-base' } = Astro.props;
const href = `${base}/${app.slug}/`;
const delayClass = delay > 0 && delay <= 4 ? ` delay-${delay}` : '';
---

<a href={href} class={`mp-card animate-fade-up${delayClass}`} aria-label={app.name}>
  <div class="mp-card-icon" style="color:var(--color-absa-500)">
    <AppIcon icon={app.icon || 'book-open'} size={20} />
  </div>
  <h2 class="text-[15px] font-semibold mb-1.5 leading-snug" style="color:var(--text-heading)">{app.name}</h2>
  <p class="text-[13px] leading-relaxed flex-1 mb-4" style="color:var(--text-body)">{app.description}</p>
  <div class="flex flex-wrap gap-1.5 mt-auto">
    {(app.tags || []).map(tag => <span class="mp-tag">{tag}</span>)}
  </div>
</a>
