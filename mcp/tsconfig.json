{
  // The MCP server and its build-time search index generator. Node 24 runs these files as-is
  // (type stripping), so the options below only allow syntax Node can erase: no enums,
  // namespaces or parameter properties, and relative imports spell their `.ts` extension.
  // `tsc -p mcp` type-checks; esbuild bundles for production.
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // The build side imports the registry helpers in src/utils/ (plain JS, unchecked).
    "allowJs": true,
    "checkJs": false,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"]
}
